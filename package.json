{
  "name": "roarplay",
  "version": "0.3.1",
  "description": "RoarPlay: plays every video and every sound file, on your own computer. The Mad Lions Lab.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/media.test.js",
    "postinstall": "node scripts/fetch-ffmpeg.js",
    "dist:mac": "node scripts/fetch-ffmpeg.js darwin-arm64 darwin-x64 && electron-builder --mac dmg --arm64 --x64 --publish never",
    "dist:win": "node scripts/fetch-ffmpeg.js win32-x64 && electron-builder --win --publish never",
    "helper": "mkdir -p build/helper && swiftc -O -target arm64-apple-macos11 -o build/helper/setdefault-arm64 helper/setdefault.swift && swiftc -O -target x86_64-apple-macos11 -o build/helper/setdefault-x64 helper/setdefault.swift && lipo -create -output build/helper/setdefault build/helper/setdefault-arm64 build/helper/setdefault-x64 && rm build/helper/setdefault-*"
  },
  "author": "THEMADLIONS",
  "type": "commonjs",
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "productName": "RoarPlay",
  "build": {
    "appId": "com.themadlions.roarplay",
    "productName": "RoarPlay",
    "npmRebuild": false,
    "directories": {
      "output": "out",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": [
          "mp4",
          "mov",
          "m4v",
          "mkv",
          "webm",
          "avi",
          "wmv",
          "flv",
          "mpg",
          "mpeg",
          "ts",
          "mts",
          "m2ts",
          "vob",
          "3gp",
          "ogv",
          "mxf",
          "dv",
          "dv",
          "mpg",
          "m2v",
          "ogv",
          "f4v",
          "asf",
          "rm",
          "rmvb",
          "y4m",
          "hevc",
          "h264"
        ],
        "name": "Video",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "mp3",
          "wav",
          "m4a",
          "aac",
          "flac",
          "ogg",
          "opus",
          "wma",
          "aiff",
          "aif",
          "caf",
          "ac3",
          "dts",
          "mka",
          "alac",
          "ape",
          "wv",
          "amr"
        ],
        "name": "Sound",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.video",
      "icon": "build/icon.png",
      "identity": null,
      "artifactName": "RoarPlay-${version}-beta-Mac-${arch}.${ext}",
      "extraResources": [
        {
          "from": "vendor/ffmpeg/darwin-${arch}",
          "to": "bin",
          "filter": [
            "ffmpeg"
          ]
        },
        {
          "from": "build/helper",
          "to": "bin",
          "filter": [
            "setdefault"
          ]
        }
      ]
    },
    "dmg": {
      "artifactName": "RoarPlay-${version}-beta-Mac-${arch}.${ext}",
      "title": "RoarPlay"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "RoarPlay-${version}-beta-Windows-Setup.${ext}",
      "extraResources": [
        {
          "from": "vendor/ffmpeg/win32-x64",
          "to": "bin",
          "filter": [
            "ffmpeg.exe"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "artifactName": "RoarPlay-${version}-beta-Windows-Setup.${ext}"
    },
    "copyright": "Copyright \u00a9 2026 THEMADLIONS",
    "afterPack": "./scripts/adhoc-sign.js"
  },
  "private": true
}
